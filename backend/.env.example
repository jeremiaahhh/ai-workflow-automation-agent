# Service identity
APP_NAME="AI Workflow Automation Agent"
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+psycopg2://agent:agent@localhost:5432/workflow_agent

# AI provider — leave USE_MOCK_AI=true to run without an API key
USE_MOCK_AI=true
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Limits & safety
MAX_STEPS_PER_PLAN=8
EXECUTION_TIMEOUT_SECONDS=30

# CORS
CORS_ORIGINS=http://localhost:3000
